# 本地开发环境配置（MySQL）
# 用法：
#   1. 复制本文件为 .env.local
#   2. 创建数据库：mysql -uroot -p -e "CREATE DATABASE chatbot_dev CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
#   3. 启动服务：./dev.sh --db=local

ENV=dev
REDIS_URL=redis://localhost:6379
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/chatbot_dev?charset=utf8mb4

# 以下密钥请保持与 .env（云环境）一致，或填入你自己的开发值
SECRET_KEY=dev-secret-key-change-me
SSO_APP_KEY=dev-sso-app-key
SSO_SECRET_KEY=dev-sso-secret-key
ID_TOKEN_EXPIRE_MINUTES=86400

DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
# JSON 值必须用单引号包裹，否则 dev.sh 用 source 加载时会解析失败
OPENAI_API_KEYS='[]'
