# 云数据库环境配置（SQL Server）模板
# 用法：
#   1. 复制本文件为 .env.cloud 并填入真实连接串
#   2. 启动服务：./dev.sh --db=cloud

ENV=dev
REDIS_URL=redis://localhost:6379
DATABASE_URL=mssql+pymssql://USER:PASSWORD@HOST:PORT/DB?charset=utf8

# 以下密钥请填入真实值
SECRET_KEY=
SSO_APP_KEY=
SSO_SECRET_KEY=
ID_TOKEN_EXPIRE_MINUTES=86400

DASHSCOPE_API_KEY=
ZHIPU_API_KEY=
# JSON 值必须用单引号包裹，否则 dev.sh 用 source 加载时会解析失败
OPENAI_API_KEYS='[]'
