# ChatbotApi 环境变量模板
# 复制为 .env 并填入实际值；.env 不要 commit

# === 运行环境 ===
ENV=dev

# === 阿里云 DashScope (通义千问) ===
DASHSCOPE_API_KEY=your-dashscope-api-key

# === JWT 签名密钥（32+ 字节随机字符串，openssl rand -hex 32 生成）===
SECRET_KEY=your-secret-key-min-32-bytes

# === SSO 单点登录 ===
SSO_APP_KEY=your-sso-app-key
SSO_SECRET_KEY=your-sso-secret-key

# === ID token 过期时间（分钟）===
ID_TOKEN_EXPIRE_MINUTES=86400

# === 存储 ===
REDIS_URL=redis://localhost:6379
# mssql+pymssql://user:password@host:port/db?charset=utf8
DATABASE_URL=mssql+pymssql://user:password@host:port/db?charset=utf8

# === 智谱 AI ===
ZHIPU_API_KEY=your-zhipu-api-key

# === OpenAI 代理（JSON 数组，每项含 host/key/model；用于多 key fallback）===
# 示例：OPENAI_API_KEYS=[{"host":"https://proxy.example.com/v1","key":"sk-xxx","model":"gpt-3.5-turbo"}]
OPENAI_API_KEYS=[]

# === HTTP 部署与跨域 ===
# 多个来源使用英文逗号分隔。默认兼容 IP + HTTP；HTTPS 部署必须显式设为 true。
CORS_ALLOWED_ORIGINS=http://localhost:3005
COOKIE_SECURE=false
# 留空时默认 lax；需要跨站 Cookie 时设为 none，并同时设置 COOKIE_SECURE=true。
COOKIE_SAMESITE=lax
